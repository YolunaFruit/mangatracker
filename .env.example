# Vercel production environment variables. Never commit actual credentials.
# Use a PostgreSQL JDBC URL (not a postgres:// URL).
DATABASE_URL=jdbc:postgresql://your-host/your-database?sslmode=require
DATABASE_USERNAME=your-database-user
DATABASE_PASSWORD=your-database-password
# Optional: MyAnimeList API client id. MangaDex works without this.
MAL_CLIENT_ID=
