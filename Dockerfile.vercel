FROM node:22-alpine AS frontend
WORKDIR /app
COPY manga-tracker-ui/package*.json ./
RUN npm ci --no-audit --no-fund
COPY manga-tracker-ui/ ./
RUN npm run build

FROM maven:3.9.11-eclipse-temurin-21 AS backend
WORKDIR /app
COPY pom.xml ./
RUN mvn -B -ntp dependency:go-offline
COPY src/ ./src/
COPY --from=frontend /app/build/ ./manga-tracker-ui/build/
RUN mvn -B -ntp package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=backend /app/target/MangaTracker-0.0.1-SNAPSHOT.jar ./app.jar
ENV SPRING_PROFILES_ACTIVE=production
ENV PORT=8080
EXPOSE 8080
USER 10001
ENTRYPOINT ["java", "-XX:TieredStopAtLevel=1", "-XX:MaxRAMPercentage=70", "-jar", "/app/app.jar"]
